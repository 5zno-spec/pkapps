{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/g/:id",
      "destination": "/game"
    }
  ],
  "redirects": [
    {
      "source": "/apps",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/apps.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
